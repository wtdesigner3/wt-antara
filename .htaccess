# ==============================================================================
# Antara Globale - Apache & Hostinger Production Configuration
# ==============================================================================

# 1. Directory Index - Always prioritize index.php
DirectoryIndex index.php index.html

# 2. Custom Error Documents
ErrorDocument 404 /404.html

# 3. Dynamic URL Rewriting (Single Master Dynamic Files)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Route legacy/clean product URLs to single master dynamic product-detail.php
    RewriteRule ^product-([a-zA-Z0-9_-]+)\.php$ product-detail.php?slug=product-$1 [L,QSA]
    RewriteRule ^supply-([a-zA-Z0-9_-]+)\.php$ product-detail.php?slug=supply-$1 [L,QSA]
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product-detail.php?slug=$1 [L,QSA]

    # Route legacy/clean blog URLs to single master dynamic blog-detail.php
    RewriteRule ^blog-details\.php$ blog-detail.php [L,QSA]
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-detail.php?slug=$1 [L,QSA]
</IfModule>

# 4. Security: Block direct HTTP access to sensitive files
<FilesMatch "^(db_config\.prod\.php|\.env.*|\.git.*|\.cpanel\.yml|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
