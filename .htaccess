# ==============================================================================
# Antara Globale - Apache & Hostinger Production Configuration
# ==============================================================================

# 1. Directory Index - Always prioritize index.php
DirectoryIndex index.php index.html

# 2. Custom Error Documents
ErrorDocument 404 /404.php

# 3. Dynamic URL Rewriting (Category & Division Based Clean Slugs)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Don't rewrite real existing files or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Clean Top-level Pages
    RewriteRule ^about/?$ about.php [L,QSA]
    RewriteRule ^contact/?$ contact.php [L,QSA]
    RewriteRule ^blog/?$ blog.php [L,QSA]
    RewriteRule ^export-supply/?$ export-supply.php [L,QSA]
    RewriteRule ^restaurant-cafe-supply/?$ restaurant-cafe-supply.php [L,QSA]

    # Category-Specific Dynamic Clean Product Routes:
    # Export Division: /export/product-tea
    RewriteRule ^export/([a-zA-Z0-9_-]+)/?$ product-detail.php?slug=$1 [L,QSA]

    # Restaurant & Cafe / HORECA Division: /restaurant/supply-sugar
    RewriteRule ^restaurant/([a-zA-Z0-9_-]+)/?$ product-detail.php?slug=$1 [L,QSA]
    RewriteRule ^horeca/([a-zA-Z0-9_-]+)/?$ product-detail.php?slug=$1 [L,QSA]

    # Generic product route fallback: /product/slug
    RewriteRule ^product/([a-zA-Z0-9_-]+)/?$ product-detail.php?slug=$1 [L,QSA]

    # Clean Dynamic Blog Article Routes: /blog/top-10-indian-spices
    RewriteRule ^blog/([a-zA-Z0-9_-]+)/?$ blog-detail.php?slug=$1 [L,QSA]

    # Legacy bridges compatibility
    RewriteRule ^product-([a-zA-Z0-9_-]+)\.php$ product-detail.php?slug=product-$1 [L,QSA]
    RewriteRule ^supply-([a-zA-Z0-9_-]+)\.php$ product-detail.php?slug=supply-$1 [L,QSA]
    RewriteRule ^blog-details\.php$ blog-detail.php [L,QSA]
</IfModule>

# 4. Security: Block direct HTTP access to sensitive files
<FilesMatch "^(db_config\.prod\.php|\.env.*|\.git.*|\.cpanel\.yml|.*\.sql)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Enable Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 6. Browser Caching for High Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
